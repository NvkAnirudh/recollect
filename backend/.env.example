# Copy to backend/.env for local overrides. Defaults already match `supabase start`.
# Never commit real values; deployed environments set these in Railway.

ENVIRONMENT=development            # development | test | staging | production
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=               # local only: printed by `supabase status` (JWT secret)
LOG_LEVEL=INFO
LOG_FORMAT=console                 # json in staging/production
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=100/minute
